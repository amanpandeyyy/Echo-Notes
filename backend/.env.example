# ==========================================
# Echo-Notes Environment Configuration
# ==========================================

# Mistral AI (Structured Summarization, Action Item Extraction, RAG Engine)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# OpenAI (Whisper English Speech-to-Text)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1

# Sarvam AI (Hindi & Hinglish Speech-to-Text Saaras Engine)
SARVAM_API_KEY=your_sarvam_api_key_here

# Hugging Face (Sentence Transformers Vector Embeddings)
HUGGINGFACE_API_KEY=your_huggingface_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Runtime Options
DEBUG=True

